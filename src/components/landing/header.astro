---
import { Image } from 'astro:assets';
//import logoLosPrimos from 'images/LOGO LOS PRIMOS BLANCO (1).png';
//import fondoHeader from '../../assets/images/losprimosedit (2).png';  // Renombra la imagen si es necesario
---

<header class="flex justify-center items-center h-20">
  <img
    src="/images/LOGO-LOS-PRIMOS-BLANCO.png"
    width="80"
    height="58"
    alt="Logo"
    loading="eager"
  />
</header>

<div class="relative">
  <img
    src="/images/losprimosedit.png"
    alt="Header fondo"
    class="img-header"
    loading="eager"
    width="1200"
    height="900"
  />

  <img
    src='/images/LOGO-LOS-PRIMOS-BLANCO.png'
    alt="Logo Los Primos Blanco"
    width="600"
    height="195"
    class="absolute bottom-8 left-1/2 transform -translate-x-1/2"
    loading="eager"
  />
</div>

<style>
  .img-header {
    mask-image: radial-gradient(ellipse 100% 70% at center, black 50%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 100% 70% at center, black 50%, transparent 70%);

    width: 100%;
    height: calc(100vh - 5rem); /* Ajusta según la altura del header */
    object-fit: cover;
    display: block;
  }
</style>
