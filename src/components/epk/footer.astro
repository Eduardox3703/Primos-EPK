---
import { Image } from "astro:assets";
// Importamos el logo con una ruta relativa correcta
// Ajusta esta ruta según la ubicación de tu componente footer
import logo from "../images/logo.png"; // Si el footer está en src/components/
// import logo from "../../images/logo.png"; // Si el footer está en src/components/alguna-carpeta/
---

<footer
    class="flex flex-col md:flex-row gap-5 items-center md:justify-between md:px-10 mt-20 w-full mb-4"
>
    <Image
        src={logo}
        width={80}
        height={58}
        alt="Los Primos Mx Logo"
        loading="eager"
    />
    <p class="text-sm text-center">
        Copyright © 2025. Los Primos Mx. <br />
        Todos los derechos reservados.
    </p>
</footer>